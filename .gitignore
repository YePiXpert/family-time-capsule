# 依赖与构建产物（mobile/ 另有自己的 .gitignore）
node_modules/
/build/
/coverage/
*.tsbuildinfo

# 本地资料与数据库：家庭内容和服务端数据都不进 git
/data/
/demo-data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# 私有配置：只提交示例
.env*
!.env.example
*.pem

# 测试与调试产物
/test-results/
/playwright-report/
/blob-report/
/debug.log
npm-debug.log*
__pycache__/
*.zip

# 只用 npm：误生成的其他包管理器文件
/pnpm-lock.yaml
/pnpm-workspace.yaml
/yarn.lock

# 系统与本地 AI 会话目录
.DS_Store
/.zcode/
/.commandcode/
