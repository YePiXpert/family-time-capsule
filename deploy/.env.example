# Template only; operational addresses and credentials belong in private configuration.
SOURCE_SHA=REPLACE_WITH_FULL_COMMIT_SHA
AI_DATA_DIR=/opt/anan-ai-staging/data
APP_PORT=3141
# Second listen address for the reverse proxy (private network); 127.0.0.1 is always bound.
APP_BIND=192.0.2.10
# Optional: address/CIDR list of the reverse proxy as the container sees it; its X-Forwarded-For then
# becomes the client address for per-address limits. Leave empty to ignore forwarded headers.
# TRUST_PROXY=192.0.2.10
AI_MODEL=gpt-6-astra
TRANSCRIBE_MODEL=mimo-v2.5-asr
UPSTREAM_BASE_URL=https://upstream.example.invalid/v1
UPSTREAM_KEY_PATH=/opt/anan-ai/secrets/upstream-key
# Direct Node scripts use UPSTREAM_KEY_FILE (an absolute secret path).
