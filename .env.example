# 数据目录：原件、衍生物、导出与 SQLite 数据库都在这里（PRD §11）。
# 数据库自动创建于 $DATA_DIR/db/capsule.sqlite。Docker 部署时由 compose 覆盖为 /data。
DATA_DIR=./data

# ---- 认证（Issue #002，docs/SECURITY.md）----

# 会话签名密钥。生产/Docker 必填，至少 32 字符。
# 生成方式：openssl rand -base64 32
AUTH_SECRET=

# 首次管理员初始化（/setup）的一次性令牌（timing-safe 比较，不入库）。
# 仅当数据库中不存在任何用户时有效；初始化完成后即可删除本变量。
# 不设置则 /setup 直接禁用。不要放入 URL 或日志。
INITIAL_SETUP_TOKEN=

# 可选：反向代理后面的对外地址（better-auth 用它做 origin 校验）
# BETTER_AUTH_URL=https://capsule.example.com

# ---- 媒体增强（可选，v0.1.2）----

# ffprobe 二进制路径。默认从 PATH 解析（Docker 镜像已内置 ffmpeg）。
# 仅当宿主机安装了 ffmpeg 但不在 PATH 时需要设置，例如：
# FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe
# 缺失时音视频仍可上传保存，仅 duration/creation_time 等元数据降级（docs/DECISIONS.md D-010）。
FFPROBE_PATH=

# ---- AI 整理（可选；默认完全关闭）----

# 仅支持显式的 OpenAI-compatible endpoint。保持 disabled 时核心档案完整可用，
# 且下面所有 AI_* 可选值必须留空，避免产生“已启用”的误解。
AI_PROVIDER=disabled

# 启用时示例：
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://provider.example/v1
# AI_API_KEY=<由部署平台 secret store 注入，绝不提交真实值>
# AI_PROVIDER_LABEL=Example private AI
# 每项能力必须独立配置；不要假设一个模型自动支持其他能力。
# AI_MODEL=<text-model-id>
# AI_VISION_MODEL=<vision-model-id>
# AI_TRANSCRIPTION_MODEL=<transcription-model-id>
# AI_EMBEDDING_MODEL=<embedding-model-id>

# Provider 请求边界（通常使用默认值即可）。
# AI_REQUEST_TIMEOUT_MS=30000
# AI_MAX_REQUEST_BYTES=33554432
# AI_MAX_RESPONSE_BYTES=4194304

# 独立 worker 的空闲轮询间隔。worker 停止不影响核心档案。
# AI_WORKER_POLL_MS=1000

# ---- 测试 / 运维（可选）----

# 登录限流覆盖（better-auth 默认 /sign-in 3 次/10 秒）。仅测试环境放宽，生产保持默认。
# AUTH_SIGNIN_RATE_LIMIT_MAX=100
