#!/usr/bin/env bash
# ftc —— Family Time Capsule 统一运维入口（1.3）。
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

run_sub() {
  local script="$HERE/$1.sh"
  shift
  [[ -f "$script" ]] || { echo "[ftc:error] 未知命令" >&2; exit 2; }
  exec bash "$script" "$@"
}

case "${1:-}" in
  install|status|doctor|deploy|upgrade|backup|restore|rollback|logs|stop|start|cleanup|setup-info)
    run_sub "$1" "${@:2}" ;;
  version)
    cat "$HERE/VERSION" ;;
  "")
    # shellcheck source=lib/common.sh
    source "$HERE/lib/common.sh"
    usage ;;
  --help|-h|help)
    # shellcheck source=lib/common.sh
    source "$HERE/lib/common.sh"
    usage ;;
  *)
    echo "[ftc:error] 未知命令：$1（见 ftc --help）" >&2
    exit 2 ;;
esac
