# Family Time Capsule 生产环境配置（由 ftc install 生成并保管）。
# 文件权限必须保持 0600；绝不提交到仓库或写进镜像。

# 最终对外 HTTPS 地址（浏览器/App 访问地址）。
BETTER_AUTH_URL=https://capsule.example.com

# 已验证的应用镜像（建议固定 digest；digest 引用需同时在 state 记录
# --version 声明的注册表版本，ftc 工具不从 digest 截取版本）。
# 可用版本见 lib/releases.json 发布注册表。
FTC_IMAGE=ghcr.io/yepixpert/family-time-capsule:1.0.0-dev.1

# Compose 项目与数据卷（同一安装终身不变，避免出现“空家庭”）。
FTC_PROJECT_NAME=family-time-capsule
FTC_DATA_VOLUME=capsule-data

# 新机器模式：域名（Caddy 自动 HTTPS）。
FTC_DOMAIN=capsule.example.com
# 已有反代模式：环回端口（由外部代理转发）。
# FTC_LOOPBACK_PORT=3001

# 会话密钥：只在首次安装时生成，升级/重跑不会重置。
AUTH_SECRET=

# 首次初始化一次性令牌：管理员建立后建议清空本值。
INITIAL_SETUP_TOKEN=

AI_PROVIDER=disabled

# M6 双路由（AI_PROVIDER=dual 时生效）：语音转写走 MiMo。
# 默认端点 https://api.xiaomimimo.com/v1，默认模型 mimo-v2.5-asr；
# 主通道（文字/图片）在 dual 模式下默认模型 gpt-5.6-luna。
# ASR_API_KEY=
# ASR_BASE_URL=https://api.xiaomimimo.com/v1
# ASR_MODEL=mimo-v2.5-asr
# ASR_LANGUAGE=auto
