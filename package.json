{
  "name": "family-time-capsule",
  "version": "1.0.0-rc.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:ops": "node scripts/build-ops.mjs",
    "start": "next start",
    "worker": "tsx --conditions=react-server jobs/worker.ts",
    "worker:once": "tsx --conditions=react-server jobs/worker.ts --once",
    "lint": "eslint",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:export": "node scripts/verify-export.mjs",
    "restore": "tsx scripts/restore.ts",
    "search:rebuild": "tsx --conditions=react-server scripts/search-rebuild.ts",
    "benchmark": "tsx --conditions=react-server scripts/benchmark.mts",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test && vitest run --config vitest.roundtrip.config.ts"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-auth": "^1.7.2",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "jszip": "^3.10.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^2.10.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "ffprobe-static": "^3.1.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
