{
  "expo": {
    "name": "家庭时间胶囊",
    "slug": "family-time-capsule",
    "platforms": ["ios", "android"],
    "scheme": "familytimecapsule",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.familytimecapsule.mobile",
      "buildNumber": "7",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSPhotoLibraryUsageDescription": "选择要保存到家庭时间胶囊的照片或视频。"
      }
    },
    "android": {
      "package": "app.familytimecapsule.mobile",
      "versionCode": 7,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"],
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "./plugins/with-native-share-intake",
      "expo-notifications",
      "expo-sqlite",
      "expo-document-picker",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "允许家庭时间胶囊安全读取登录凭据。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "选择要保存到家庭时间胶囊的照片或视频。",
          "cameraPermission": "拍摄要保存到家庭时间胶囊的照片或视频。",
          "microphonePermission": "录制要保存到家庭时间胶囊的视频声音。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "读取所选素材的可靠创建时间，避免把导入时间误作拍摄时间。",
          "savePhotosPermission": "允许将明确选择保存的素材写入系统相册。",
          "granularPermissions": ["photo", "video"]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "录制要保存到家庭时间胶囊的家庭声音。",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}
