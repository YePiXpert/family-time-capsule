{
  "expo": {
    "name": "桉桉成长记",
    "slug": "family-time-capsule",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "familytimecapsule",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.familytimecapsule.mobile",
      "buildNumber": "89",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "选择要保存到桉桉成长记的照片或视频。",
        "NSSpeechRecognitionUsageDescription": "把你说的话转成文字，只在这台手机上完成。"
      }
    },
    "android": {
      "package": "app.familytimecapsule.mobile",
      "versionCode": 89,
      "blockedPermissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO_BACKGROUND"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#B2543B",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/with-native-share-intake",
      "expo-sqlite",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "选择要保存到桉桉成长记的照片或视频。",
          "cameraPermission": "拍摄要保存到桉桉成长记的照片或视频，或扫家人手机上的加入二维码。",
          "microphonePermission": "录制要保存到桉桉成长记的视频声音。"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "录制要保存到桉桉成长记的家庭声音。",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "把拍摄坐标换成地名时使用定位。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "拍摄要保存到桉桉成长记的照片或视频，或扫家人手机上的加入二维码。",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications"
    ]
  }
}
