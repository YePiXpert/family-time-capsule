{
  "expo": {
    "name": "小美成长记",
    "slug": "family-time-capsule",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "familytimecapsule",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.familytimecapsule.mobile",
      "buildNumber": "31",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSPhotoLibraryUsageDescription": "选择要保存到小美成长记的照片或视频。"
      }
    },
    "android": {
      "package": "app.familytimecapsule.mobile",
      "versionCode": 31,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFAF5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "./plugins/with-native-share-intake",
      "expo-notifications",
      "expo-sqlite",
      "expo-document-picker",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "允许小美成长记安全读取登录凭据。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "选择要保存到小美成长记的照片或视频。",
          "cameraPermission": "拍摄要保存到小美成长记的照片或视频。",
          "microphonePermission": "录制要保存到小美成长记的视频声音。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "读取所选素材的可靠创建时间，避免把导入时间误作拍摄时间。",
          "savePhotosPermission": "允许将明确选择保存的素材写入系统相册。",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "录制要保存到小美成长记的家庭声音。",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
