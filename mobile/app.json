{
  "expo": {
    "name": "\u6849\u6849\u6210\u957f\u8bb0",
    "slug": "family-time-capsule",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "familytimecapsule",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.familytimecapsule.mobile",
      "buildNumber": "72",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "\u9009\u62e9\u8981\u4fdd\u5b58\u5230\u6849\u6849\u6210\u957f\u8bb0\u7684\u7167\u7247\u6216\u89c6\u9891\u3002",
        "NSSpeechRecognitionUsageDescription": "\u628a\u4f60\u8bf4\u7684\u8bdd\u8f6c\u6210\u6587\u5b57\uff0c\u53ea\u5728\u8fd9\u53f0\u624b\u673a\u4e0a\u5b8c\u6210\u3002"
      }
    },
    "android": {
      "package": "app.familytimecapsule.mobile",
      "versionCode": 72,
      "blockedPermissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO_BACKGROUND"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FAF5EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/with-native-share-intake",
      "expo-sqlite",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "\u9009\u62e9\u8981\u4fdd\u5b58\u5230\u6849\u6849\u6210\u957f\u8bb0\u7684\u7167\u7247\u6216\u89c6\u9891\u3002",
          "cameraPermission": "\u62cd\u6444\u8981\u4fdd\u5b58\u5230\u6849\u6849\u6210\u957f\u8bb0\u7684\u7167\u7247\u6216\u89c6\u9891\u3002",
          "microphonePermission": "\u5f55\u5236\u8981\u4fdd\u5b58\u5230\u6849\u6849\u6210\u957f\u8bb0\u7684\u89c6\u9891\u58f0\u97f3\u3002"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "\u5f55\u5236\u8981\u4fdd\u5b58\u5230\u6849\u6849\u6210\u957f\u8bb0\u7684\u5bb6\u5ead\u58f0\u97f3\u3002",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "\u628a\u62cd\u6444\u5750\u6807\u6362\u6210\u5730\u540d\u65f6\u4f7f\u7528\u5b9a\u4f4d\u3002"
        }
      ]
    ]
  }
}
